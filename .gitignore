# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ML artefacts — pretrained COCO/base weights auto-download via ultralytics
# and training intermediates regenerate via backend/training/*, so neither is
# committed. The fine-tuned deliverable in models/ (pamela_head.pt, ~5MB) IS
# tracked — that's the actual research output of this project.
*.pt
!models/*.pt
datasets/
runs/
__pycache__/
*.pyc
.venv/

# Secrets — real API keys live here locally, never commit.
# .env.example (placeholders only) is the one tracked exception.
.env
.env.*
!.env.example

# Sample/training footage — vendor demo clips (licensing) + own screen
# recordings (size, ~600MB total). See README "Data" section for how to
# populate this locally; backend/main.py works with an empty test_data/.
test_data/

# Benchmark ground-truth is small and portable — keep it tracked
!benchmarks/
live_demo/
out/

# Python tooling caches, local virtualenvs and TypeScript build info
.pytest_cache/
.ruff_cache/
venv/
*.tsbuildinfo

# Raw PAMELA-UANDES archive extracted at the repo root (research-only licence,
# ~370MB) — the supported location is test_data/pamela-uandes/
2008_*_ov_0_800/
*.tar.gz
