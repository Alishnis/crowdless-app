# Copy to .env (git-ignored) and fill in. Vite only exposes variables that
# start with VITE_, and inlines them into the JS bundle at build time, so never
# put a secret here — anything below ends up readable in the browser.

# Base URL of the FastAPI backend. Leave empty for local development: the
# lab/monitor pages then fall back to http://localhost:8000.
# For a deployed build set it to the backend's public URL, e.g. http://my-host:8000
VITE_API_URL=

# Google Maps JavaScript API key, used by the /map and /monitor map views.
# Without it those views show a "add a key" hint instead of the map.
# Create one at https://console.cloud.google.com/ and restrict it to your
# own domains (HTTP referrers) — it is public by design.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
